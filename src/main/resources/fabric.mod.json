{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["HxPLukas"],
  "contact": {
    "sources": "https://github.com/hxplukas/hxpaddons"
  },
  "icon": "assets/hxpaddons/icon.png",
  "license": "BSD 3-Clause",
  "environment": "client",
  "entrypoints": {
    "modmenu": [
      "de.hxp.hxpaddons.clickgui.ModMenuIntegration"
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "de.hxp.hxpaddons.HxPMod"
      }
    ]
  },
  "accessWidener": "hxpaddons.accesswidener",
  "mixins": [
    "hxpaddons.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/8Fqsg5xBP3"
      },
      "update_checker": true
    }
  }
}
